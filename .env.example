# =============================================================================
# Roostoo live trading bot - environment variables
# Copy this file to ".env" and fill in real values.  NEVER commit ".env".
# Secrets are injected here only; they are never written to logs or the repo.
# =============================================================================

# Set to 1 / true / yes to place REAL orders on the Roostoo exchange.
# Leave unset (or 0) to run in PAPER mode (no real orders are sent).
LIVE=0

# Roostoo API credentials (provided by the competition organisers).
ROOSTOO_API_KEY=
ROOSTOO_API_SECRET=

# Roostoo mock REST endpoint (do not change unless instructed).
ROOSTOO_BASE_URL=https://mock-api.roostoo.com
