# =============================================================================
# Roostoo live trading bot - environment variables
# Copy this file to ".env" and fill in real values.  NEVER commit ".env".
# Secrets are injected here only; they are never written to logs or the repo.
# =============================================================================

# Enable Roostoo connectivity mode. Leave 0 for local paper simulation.
LIVE=0

# Second live-order gate: BOTH values below are required before any real order
# can be sent. Keep them empty in normal development.
ROOSTOO_LIVE_TRADING=false
ROOSTOO_LIVE_CONFIRM=
# Required exact confirmation string:
# I_UNDERSTAND_AND_ACCEPT_LIVE_TRADING_RISK

# Roostoo API credentials (provided by the competition organisers).
ROOSTOO_API_KEY=
ROOSTOO_API_SECRET=

# Explicit profiles never fall back to another account. Do not commit values.
# Set ROOSTOO_ACCOUNT=test (or competition) when using these names.
ROOSTOO_TEST_API_KEY=
ROOSTOO_TEST_API_SECRET=
ROOSTOO_COMPETITION_API_KEY=
ROOSTOO_COMPETITION_API_SECRET=

# Roostoo mock REST endpoint (do not change unless instructed).
ROOSTOO_BASE_URL=https://mock-api.roostoo.com
