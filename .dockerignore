# =============================================================================
# .dockerignore — keep the image lean and free of secrets / local state.
# =============================================================================

# Version control
.git
.gitignore

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/

# Virtual environments
.venv/
venv/
env/

# Secrets / local environment
.env
*.env

# Local runtime state & logs (recreated inside the container)
bot/logs/*
!bot/logs/.gitkeep
bot/state.json
bot/KILL
cache/
outputs/*

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Local workbench
.workbuddy/
*.md~
