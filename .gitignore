# =============================================================================
# .gitignore — keep secrets, local state and caches out of the repo.
# =============================================================================

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/

# Virtual environments
.venv/
venv/
env/

# Secrets / local environment (NEVER commit these)
.env
*.env

# Local runtime state & logs (recreated at runtime; keep the dir via .gitkeep)
bot/logs/*
!bot/logs/.gitkeep
bot/state.json
bot/volume_state.json
bot/volume_logs/
bot/cash85_state.json
bot/cash85_logs/
*.sqlite3
*.sqlite3-journal
bot/KILL
cache/

# Generated outputs
outputs/*
!outputs/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Local workbench
.workbuddy/
